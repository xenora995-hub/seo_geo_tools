generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  cmsType   CmsType
  cmsUrl    String
  cmsApiKey String
  language  String   @default("id")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  articles      Article[]
  schedules     Schedule[]
  reports       Report[]
  setting       TenantSetting?
  rankProjects     RankTrackingProject[]
  siteAudits       SiteAuditReport[]
  backlinkProfiles BacklinkProfile[]
  geoBacklinkTasks GeoBacklinkTask[]
  localListings    LocalListingProfile[]
  seoDocuments     SeoWritingDocument[]
  claimedNiches    ClaimedNiche[]
  branches         BranchProfile[]
  aiVisibilityRuns AiVisibilityTestRun[]
  auditFindings    AuditFindingItem[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  content     String        @db.Text
  excerpt     String
  keywords    String[]
  imageUrl    String?
  imagePrompt String?
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  cmsPostId   String?
  cmsPostUrl  String?
  errorLog    String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Schedule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  cronExpr  String
  topic     String?
  isActive  Boolean  @default(true)
  startDate DateTime?
  endDate   DateTime?
  lastRun   DateTime?
  nextRun   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      ReportType
  data      Json
  sentAt    DateTime   @default(now())
}

model TenantSetting {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telegramChatId   String?
  telegramBotToken String?
  googleServiceAccountJson String? @db.Text
  geminiApiKey     String   @default("")
  articlesPerDay   Int      @default(1)
  imageStyle       String   @default("professional photography, clean background")
  businessNiche    String?
  targetKeywords   String[]
  competitors      String[]
  customPrompt     String?  @db.Text
  timezone         String   @default("Asia/Jakarta")
  enableAutoIndex  Boolean  @default(false)
  lastCrawlerRun   DateTime?
  updatedAt        DateTime @updatedAt
}

enum CmsType {
  WORDPRESS
  LARAVEL
  BLOGGER
}

enum Role {
  SUPERUSER
  ADMIN
  VIEWER
}

enum ArticleStatus {
  PENDING
  DRAFT
  PUBLISHED
  FAILED
}

enum ReportType {
  DAILY
  WEEKLY
}

model Keyword {
  id           String   @id @default(cuid())
  term         String   @unique
  volume       Int      @default(0)
  difficulty   Int      @default(0)
  cpc          Float    @default(0.0)
  searchIntent String?
  location     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RankTrackingProject {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain    String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories RankHistory[]
}

model RankHistory {
  id        String              @id @default(cuid())
  projectId String
  project   RankTrackingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword   String
  rank      Int
  url       String?
  createdAt DateTime            @default(now())
}

model SiteAuditReport {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url         String
  healthScore Int      @default(0)
  errors      Int      @default(0)
  warnings    Int      @default(0)
  notices     Int      @default(0)
  createdAt   DateTime @default(now())
}

model BacklinkProfile {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain           String
  domainRating     Int      @default(0)
  totalBacklinks   Int      @default(0)
  referringDomains Int      @default(0)
  createdAt        DateTime @default(now())
}

model LocalListingProfile {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessName String
  address      String
  phone        String
  website      String?
  category     String?
  syncStatus   String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SeoWritingDocument {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title            String
  content          String   @db.Text
  targetKeywords   String[]
  seoScore         Int      @default(0)
  readabilityScore Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ClaimedNiche {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
}

model GeoBacklinkTask {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain       String
  targetUrl    String
  domainRating Int      @default(0)
  category     String
  strategy     String   @db.Text
  tutorial     Json     // Array of tutorial steps
  status       String   @default("PENDING") // PENDING or DONE
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BranchProfile {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchName      String   // e.g. "iSmart Canggu", "Bale Bali", "iSmart Teuku Umar"
  branchCode      String   // e.g. "ISMART_CANGGU", "BALE_BALI", "ISMART_TEUKU_UMAR"
  relationship    String   // "Branch of Bali Phone Repair"
  address         String
  city            String   @default("Bali")
  areaServed      String[] // ["Canggu", "Berawa", "Pererenan"]
  phone           String
  openingHours    String   // "Mo-Sa 09:00-21:00, Su 09:00-18:00"
  googleMapsUrl   String?
  pageUrl         String?
  isWalkIn        Boolean  @default(true)
  hasVillaService Boolean  @default(true)
  hasPickup       Boolean  @default(true)
  servicesOffered String[]
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, branchCode])
}

model AiVisibilityTestRun {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  query              String   // Natural language user question
  sourceType         String   // "MANUAL_CHATGPT_APP" | "OPENAI_WEB_SEARCH" | "GEMINI_SEARCH_GROUNDING" | "LEGACY_UNVERIFIED"
  model              String   // e.g. "ChatGPT App (GPT-4o)", "gpt-4o-search-preview"
  status             String   // "not_checked" | "mentioned" | "cited" | "not_found_in_run" | "error"
  brandMentioned     Boolean  @default(false)
  domainCited        Boolean  @default(false)
  domainInSources    Boolean  @default(false)
  citationUrls       String[]
  responseText       String   @db.Text
  evidenceNotes      String?  @db.Text
  searchSources      Json?
  errorMessage       String?  @db.Text
  isLegacySimulation Boolean  @default(false)
  testedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
}

model AuditFindingItem {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targetUrl      String
  category       String    // "BRANCH_IDENTITY" | "CONTENT_GAP" | "ROBOTS_INDEXABILITY" | "SCHEMA_DATA" | "CLAIM_INTEGRITY"
  priority       String    // "HIGH" | "MEDIUM" | "LOW"
  issue          String
  evidence       String    @db.Text
  recommendation String    @db.Text
  proposedPatch  String?   @db.Text
  canAutoFix     Boolean   @default(false)
  status         String    @default("OPEN") // "OPEN" | "REVIEWED" | "PATCH_READY" | "PUBLISHED" | "VERIFIED"
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
