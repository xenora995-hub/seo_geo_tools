{
  "name": "seogeo/seo-geo-receiver",
  "description": "Laravel receiver package for SEO/GEO automation tools",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "SEO/GEO Tools Team",
      "email": "support@seogeo.com"
    }
  ],
  "require": {
    "php": "^8.0|^8.1|^8.2|^8.3",
    "illuminate/support": "^9.0|^10.0|^11.0",
    "illuminate/routing": "^9.0|^10.0|^11.0",
    "illuminate/http": "^9.0|^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "SeoGeo\\Receiver\\": "src/"
    }
  },
  "extra": {
